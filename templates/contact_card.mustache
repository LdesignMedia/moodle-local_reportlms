{{!
    @template local_reportlms/contact_card

    The question shown to a site administrator in place of the report when
    Report LMS holds no contact address for the site.

    Context variables required for this template:
    * action - Where the form posts to
    * sesskey - The session key guarding the post
    * email - What the field starts with
    * invalid - True when the last attempt to save was refused
    * backurl - The way out
    * lockup - The branded heading markup

    Example context (json):
    {
        "action": "https://example.org/local/reportlms/view.php",
        "sesskey": "abcdef1234",
        "email": "admin@example.org",
        "invalid": false,
        "backurl": "https://example.org/my/",
        "lockup": "<span>Report LMS</span>"
    }
}}
<div class="local-reportlms-page">
    <div class="local-reportlms-header">
        <h1 class="local-reportlms-heading">{{{lockup}}}</h1>
        <div class="local-reportlms-actions">
            <a class="btn local-reportlms-btn" href="{{backurl}}">{{#str}} dashboard:back, local_reportlms {{/str}}</a>
        </div>
    </div>
    <div class="local-reportlms-contact">
        <h2 class="local-reportlms-contact-title">{{#str}} contact:title, local_reportlms {{/str}}</h2>
        <p class="local-reportlms-contact-intro">{{#str}} contact:intro, local_reportlms {{/str}}</p>
        {{#invalid}}
            <div class="alert alert-danger" role="alert">{{#str}} contact:invalid, local_reportlms {{/str}}</div>
        {{/invalid}}
        <form method="post" action="{{action}}" class="local-reportlms-contact-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="savecontact" value="1">
            <label for="local-reportlms-contactemail" class="local-reportlms-contact-label">
                {{#str}} contact:field, local_reportlms {{/str}}
            </label>
            <input type="email" id="local-reportlms-contactemail" name="contactemail" value="{{email}}"
                class="form-control" required aria-describedby="local-reportlms-contact-help">
            <p id="local-reportlms-contact-help" class="local-reportlms-contact-help">
                {{#str}} contact:help, local_reportlms {{/str}}
            </p>
            <button type="submit" class="btn btn-primary">{{#str}} contact:save, local_reportlms {{/str}}</button>
        </form>
    </div>
</div>
